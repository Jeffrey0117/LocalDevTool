# LocalDevTool — 環境變數範例
#
# 全部都是選用的。複製成 .env 之後自己改（.env 已在 .gitignore 裡）。
# 注意：這個專案**不會**自動載入 .env（零依賴，沒有 dotenv）。
# 用法是把變數設進環境再啟動，例如：
#   PowerShell:  $env:PORT=41000; npm start
#   bash:        PORT=41000 npm start

# ─────────────────────────────────────────────────────────────
# 服務
# ─────────────────────────────────────────────────────────────

# 監聽的 port（預設 30700）
PORT=30700

# 綁定位址（預設 127.0.0.1）。
# ⚠ 改成 0.0.0.0 等於把管理後台與蒐集到的流量紀錄曝露到整個區網。
HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────
# 認證
# ─────────────────────────────────────────────────────────────

# 管理後台 token。沒設的話首次啟動會產生 32 bytes 隨機 hex，
# 寫進 data/admin-token.txt 並印在啟動 log。
# 絕對沒有 hardcoded 預設值，也沒有「沒設就不驗證」。
# LOCALDEVTOOL_ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────
# ⚠ 危險開關（只認字串 "1"，其他值都視為關閉）
# ─────────────────────────────────────────────────────────────

# 關閉憑證遮蔽。開啟後 Cookie / Authorization / access_token 會以
# **明文**寫入 SQLite —— 那個 .db 檔從此等同一包憑證。
# 只在你完全清楚自己在做什麼、而且資料庫不會被備份或同步出去時使用。
# LOCALDEVTOOL_CAPTURE_SECRETS=1

# 放行私網位址（loopback / 10.x / 192.168.x / link-local …）。
# 代理自己的 dev server 需要這個，但它同時放寬了 SSRF 防護。
# 雲端 metadata 端點（metadata.google.internal 等）不受此開關影響，一律封鎖。
# LOCALDEVTOOL_ALLOW_PRIVATE=1

# ─────────────────────────────────────────────────────────────
# 擷取與保留
# ─────────────────────────────────────────────────────────────

# 單一 body 的擷取上限（bytes，預設 262144 = 256KB）。
# 超過就截斷並設 body_truncated=1。binary 類型一律只記 metadata、不存 body。
LOCALDEVTOOL_BODY_CAP=262144

# 保留策略（取先到者）：預設 7 天 / 50000 筆。啟動時與每小時各清一次。
LOCALDEVTOOL_RETENTION_DAYS=7
LOCALDEVTOOL_RETENTION_MAX=50000

# 資料庫路徑（預設 data/localdevtool.db）
# LOCALDEVTOOL_DB=

# ─────────────────────────────────────────────────────────────
# 代理與 Inspector
# ─────────────────────────────────────────────────────────────

# 上游請求逾時（ms，預設 30000）
LOCALDEVTOOL_UPSTREAM_TIMEOUT_MS=30000

# Inspector 載入頁面後的等待時間（ms，預設 8000）
LOCALDEVTOOL_INSPECT_WAIT_MS=8000

# 同時可以跑幾個 inspect job（預設 2）。每個 job 是一顆真的 Chromium，
# 記憶體以百 MB 計，不建議調高。
LOCALDEVTOOL_MAX_INSPECT_JOBS=2

# ─────────────────────────────────────────────────────────────
# 被代理頁面的上報端點 /__ldt/events
# ─────────────────────────────────────────────────────────────

# 單次上報的 payload 上限（bytes，預設 65536 = 64KB）
LOCALDEVTOOL_EVENT_PAYLOAD_CAP=65536

# 每個來源 IP 每分鐘的上報次數上限（預設 600）
LOCALDEVTOOL_EVENT_RATE_LIMIT=600
